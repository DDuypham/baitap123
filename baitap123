using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DQbt1_tinh_tong
{
    internal class Program
    {
        //BT1: tính tổng của n số nguyên dương đầu tiên
        // S(n) = 1 + 2 + 3 + ... + n - 1 + n, n > 0
        static void Main(string[] args)
        {
            Console.WriteLine("Nhap so nguyen n > 0");

            //nhập số nguyên n
            Console.WriteLine("Nhap vao so nguyen n: ");
            int n = int.Parse(Console.ReadLine());

            //Gọi hàm đệ quy tính tổng
            Console.WriteLine("Tinh tong so nguyen n: " + Tong(n));

            Console.ReadKey();
        }

        //Hàm đệ quy tính tổng
        static int Tong(int n)
        {
            if (n == 1)
                return 1;
            else
                return Tong(n - 1) + n;
        }
    }
}
