using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DQbt3_tinhFn
{
    internal class Program
    {
        //BT3: Tính f (n)
        // f(n) = n; f(n - 1) + 2f (n - 2) + 3f (n - 3)
        // n <= 3, n > 3
        static void Main(string[] args)
        {
            //Nhập giá trị n
            Console.WriteLine("Nhap gia tri n: ");
            int n = int.Parse(Console.ReadLine());

            //Gọi hàm đệ quy
            Console.WriteLine($"f(n) = {Tinhfn(n)}");

            Console.ReadKey();
        }

        //Hàm đệ quy tính f(n)
        static int Tinhfn(int n)
        {
            if (n <= 3)
                return n;
            else
                return Tinhfn(n - 1) + 2* Tinhfn(n - 2) + 3 * Tinhfn(n - 3);
        }
    }
}
