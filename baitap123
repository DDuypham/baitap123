using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DQbt2_tinhtong_TH
{
    internal class Program
    {
        //BT2:Tính tổ hợp chập K của n phần tử
        //k = 0 V k = n ; 0 < k < n
        static void Main(string[] args)
        {
            //Nhập số nguyên k
            Console.WriteLine("Nhap so nguyen k: ");
            int k = int.Parse(Console.ReadLine());
            //Nhập số nguyên n
            Console.WriteLine("Nhap so nguyen n: ");
            int n = int.Parse(Console.ReadLine());

            //Gọi hàm đệ quy
            Console.WriteLine("To hop chap k cua n la: " + Tohop(n, k));

            Console.ReadKey();
        }

        //Hàm đệ quy tính tổ hợp chập k của n phần tử
        static int Tohop(int n, int k)
        {
            if (k == 0 || k == n )
                return 1;
            else
                return Tohop(n - 1, k) + Tohop(n - 1, k - 1);
        }
    }
}
